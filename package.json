{
  "name": "storyflow",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.tingrongsu.storyflow",
    "productName": "StoryFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.video",
      "target": ["zip"],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "icon": null
    },
    "fileAssociations": [
      {
        "ext": "sf",
        "name": "StoryFlow Document",
        "role": "Editor",
        "isPackage": false,
        "icon": "build/sf.icns"
      }
    ]
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "wait-on": "^9.5.1"
  }
}
